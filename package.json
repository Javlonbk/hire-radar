{
  "name": "hire-radar",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": { "hire-radar": "bin/hire-radar" },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:better-sqlite3 --outfile=dist/hire-radar.js && cp src/db/schema.sql dist/schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "better-sqlite3": "^12.4.1",
    "commander": "^15.0.0",
    "dotenv": "^16.4.0",
    "iconv-lite": "^0.6.3",
    "rss-parser": "^3.13.0",
    "telegram": "^2.17.4",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
